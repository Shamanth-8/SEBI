# Keep the build context small — without this the whole venv and the downloaded
# SEBI PDFs are shipped to the daemon on every build.
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo

.git/
.gitignore
.claude/

# Regenerated inside the image by scripts/generate_corpus.py + train_model.py
data/
cache/

# Large source PDFs — fetched at runtime with scripts/fetch_sebi_corpus.py
*.pdf

# Local-only config; supply real values as container env vars
.env
.env.local

# frontend/ IS needed — the image runs the dashboard and the API together
# (Hugging Face Spaces exposes a single port, so both live in one container).
lib/
regraph/
demo_report.html
ARCHITECTURE.md
DATASET_GUIDE.md
OPENROUTER_SETUP.md
