# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (recommended — free tier available)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Free model (less accurate but no cost):
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Paid model (best results):
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Option B: Direct Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── App settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Storage paths (auto-created on first run) ─────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index
GRAPH_DB_PATH=./data/obligation_graph.pkl
