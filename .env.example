# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (recommended — free tier available)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Free model (less accurate but no cost):
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Paid model (best results):
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Option B: Direct Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── App settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Storage paths (auto-created on first run) ─────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index
GRAPH_DB_PATH=./data/obligation_graph.pkl

# ── Notifications ─────────────────────────────────────────────────────────────
# Email digest (SMTP)
NOTIFY_EMAIL_TO=compliance@yourfirm.com
NOTIFY_EMAIL_FROM=regraph@yourfirm.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password          # Use Gmail App Password, not your login password
SMTP_USE_TLS=true

# Slack / generic webhook (POST JSON payload)
# For Slack: create an Incoming Webhook at https://api.slack.com/apps
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Alert thresholds
NOTIFY_DUE_SOON_DAYS=7       # alert if obligation due within this many days
NOTIFY_MIN_SEVERITY=medium   # only alert for medium and high severity (low | medium | high)
