# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (recommended — free tier available)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional. The free tier is 50 requests/day PER KEY and one large circular can
# spend that, so a second key is switched to automatically on a 429/401/402.
# Comma-separate for more than one.
OPENROUTER_API_KEY_BACKUP=
# Free model (less accurate but no cost):
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Paid model (best results):
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Option B: Direct Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Local model (app/ml — trained on the synthetic corpus) ────────────────────
# hybrid : local model always extracts, the LLM enriches when reachable (default)
# ml     : local model only — fully offline, works with no API key at all
# llm    : LLM only (original behaviour; a provider outage means zero obligations)
EXTRACTION_MODE=hybrid
# Probability above which a sentence counts as an obligation.
# Lower = higher recall, more noise. 0.55 was tuned on the real 38-page circular.
ML_OBLIGATION_THRESHOLD=0.55
MODEL_DIR=./data/models
# One extra LLM call per circular for the narrative insight layer.
ENABLE_AI_INSIGHTS=true

# ── LLM reliability / cost ────────────────────────────────────────────────────
LLM_MAX_RETRIES=3
# Output budget per extraction chunk. Too low truncates the JSON array mid-object.
EXTRACTION_MAX_TOKENS=4000
EXTRACTION_CHUNK_SIZE=6000
# LLM-written SOPs cost one call per obligation. Off by default.
ENABLE_LLM_SOP=false

# ── App settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Storage paths (auto-created on first run) ─────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index
GRAPH_DB_PATH=./data/obligation_graph.pkl

# ── Notifications ─────────────────────────────────────────────────────────────
# Email digest (SMTP)
NOTIFY_EMAIL_TO=compliance@yourfirm.com
NOTIFY_EMAIL_FROM=regraph@yourfirm.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password          # Use Gmail App Password, not your login password
SMTP_USE_TLS=true

# Slack / generic webhook (POST JSON payload)
# For Slack: create an Incoming Webhook at https://api.slack.com/apps
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Alert thresholds
NOTIFY_DUE_SOON_DAYS=7       # alert if obligation due within this many days
NOTIFY_MIN_SEVERITY=medium   # only alert for medium and high severity (low | medium | high)
